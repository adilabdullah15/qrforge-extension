{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "Generate beautiful, customizable QR codes instantly. Right-click any link or text to turn it into a QR code.",
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "QRForge — QR Code Generator",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "version": "1.2.0"
}